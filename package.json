{
  "name": "netexpert-mcp",
  "version": "0.1.2",
  "mcpName": "io.github.Omodaka9375/netexpert-mcp",
  "description": "Cross-platform local-network diagnostics & security-posture MCP server — the local host + LAN half; complements ugnas-mcp (the NAS half). 31 tools, bounded probes, no shells, no raw sockets.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "netexpert-mcp": "dist/server.js" },
  "main": "dist/server.js",
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:http": "node scripts/http-smoke.mjs",
    "gen:oui": "node scripts/gen-oui.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "network",
    "diagnostics",
    "lan",
    "wifi",
    "dns",
    "security-posture",
    "homelab",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omodaka9375/netexpert-mcp.git"
  },
  "bugs": "https://github.com/Omodaka9375/netexpert-mcp/issues",
  "homepage": "https://github.com/Omodaka9375/netexpert-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "default-gateway": "^7.2.1",
    "systeminformation": "^5.23.0",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/default-gateway": "^7.2.2",
    "@types/node": "^20.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}